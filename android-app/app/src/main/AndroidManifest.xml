<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. App shell, updates, backend-free local backend -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 2. Fingerprint gate (BiometricPrompt) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- 3. Haptic feedback on login/buttons -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 4. Security alerts (runtime prompt on Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 5. Future avatar capture / QR login -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 6. Gallery avatar pick -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- 7. Rough region for the admin activity log -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 8. Re-arm reminders after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 9-10. Never block installs on devices missing hardware -->
    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.HTS">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".notify.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
