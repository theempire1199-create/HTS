rules_version = '2';

// HASAN TECH STUDIO — Firestore schema + security
//
// Schema:
//   users/{uid}:
//     name, email, contact, createdAt, lastLoginAt,
//     loginCount, emailVerified, updatedAt
//   users/{uid}/logins/{autoId}:
//     timestamp, identifier
//
// Setup: Firebase console -> Build -> Firestore Database ->
// Create database (Production mode) -> Rules tab -> ye file paste -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // User sirf apna hi doc padh/likh sakta hai
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;

      match /logins/{loginId} {
        allow read, create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false;
      }
    }
  }
}
